#!/command/with-contenv sh
set -eu
umask 077
mkdir -p /data
for name in key_pub key_priv; do
  case "$name" in key_pub) path=/data/id_ed25519.pub ;; key_priv) path=/data/id_ed25519 ;; esac
  if [ ! -f "$path" ] && [ -r "/run/secrets/$name" ]; then cp "/run/secrets/$name" "$path"; fi
done
if [ ! -f /data/id_ed25519.pub ] && [ -n "${KEY_PUB:-}" ]; then printf '%s' "$KEY_PUB" > /data/id_ed25519.pub; fi
if [ ! -f /data/id_ed25519 ] && [ -n "${KEY_PRIV:-}" ]; then printf '%s' "$KEY_PRIV" > /data/id_ed25519; fi
exec /usr/local/bin/rustdesk-entrypoint init
